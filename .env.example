# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT: copy this to .env and fill in your values
#
# DEVELOPMENT  → LLM=ollama,  STT=groq,   TTS=groq
# PRODUCTION   → LLM=groq,    STT=sarvam, TTS=sarvam
# ═══════════════════════════════════════════════════════════════

# ── Provider selection ────────────────────────────────────────
# Dev:
# LLM_PROVIDER=ollama
# STT_PROVIDER=groq
# TTS_PROVIDER=groq

# Production (Sarvam — lightweight, no torch/piper needed):
LLM_PROVIDER=groq
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam

# ── API Keys ──────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=              # get from https://dashboard.sarvam.ai

# ── LLM config ────────────────────────────────────────────────
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_HOST=http://ollama:11434   # docker-compose service name
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
MAX_TOOL_CALLS=3

# ── STT config ────────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
VAD_THRESHOLD=0.6

# ── TTS config ────────────────────────────────────────────────
PIPER_VOICE_EN=models/piper/en_US-lessac-medium.onnx
PIPER_VOICE_HI=models/piper/hi_IN-hindi_ldcil-medium.onnx
TTS_TARGET_RATE=24000

# ── Server ────────────────────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8765
API_HOST=0.0.0.0
API_PORT=8766
SECRET_KEY=change-me-in-production   # change this!

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ── Hardware ──────────────────────────────────────────────────
ESP32_CAR_URL=http://robotcar.local
CAR_CMD_TIMEOUT=0.5

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ── PostgreSQL (optional — for persistent conversation memory) ─
POSTGRES_ENABLED=false
POSTGRES_URL=postgresql://user:password@localhost:5432/agentdb

# ── MediaPipe ─────────────────────────────────────────────────
FACE_MODEL_PATH=models/face_landmarker.task
NUM_FACES=1
